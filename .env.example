# ============================================================
# Epic Kiosk 环境变量配置文件
# ============================================================
# 复制此文件为 .env 并填写你的配置
# cp .env.example .env
# ============================================================

# SiliconFlow API Key（必须配置）
# 获取地址: https://cloud.siliconflow.cn/i/OVI2n57p （分享链接，双方可获得 16 元代金券）
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容 API 地址（SiliconFlow）
API_BASE_URL=https://api.siliconflow.cn/v1

# Web 与 Worker 内部接口共享密钥（必须使用随机值）
# 生成命令: openssl rand -hex 32
INTERNAL_API_TOKEN=replace-with-a-random-64-character-hex-token

# SiliconFlow 实测默认模型
PRIMARY_MODEL=deepseek-ai/DeepSeek-V4-Flash
PRIMARY_MODEL_FALLBACK=deepseek-ai/DeepSeek-V4-Pro
CAPTCHA_MODEL=Qwen/Qwen3-VL-30B-A3B-Thinking
CAPTCHA_MODEL_FALLBACK=Qwen/Qwen3.5-397B-A17B

# 验证码失败恢复策略
CAPTCHA_FAILURE_MAX_RETRIES=2
CAPTCHA_FAILURE_RETRY_DELAY_SECONDS=900
NETWORK_FAILURE_MAX_RETRIES=2
NETWORK_FAILURE_RETRY_DELAY_SECONDS=600
WARP_RESTART_COOLDOWN_SECONDS=300
TASK_SPACING_SECONDS=5
TASK_TIMEOUT_SECONDS=600
TASK_LOCK_SECONDS=86400

# 仅正式 Web 服务应启用每日自动调度；临时预览容器不要启用。
ENABLE_APSCHEDULER=true
DAILY_SCHEDULE_LOCK_SECONDS=86400

HCAPTCHA_EXECUTION_TIMEOUT=180
HCAPTCHA_RESPONSE_TIMEOUT=45
HCAPTCHA_PAYLOAD_TIMEOUT=45
HCAPTCHA_FRAME_TIMEOUT=20
HCAPTCHA_SOLVE_MAX_ATTEMPTS=2
