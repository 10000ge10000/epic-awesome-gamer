# ============================================================
# Epic Kiosk 环境变量配置文件
# ============================================================
# 复制此文件为 .env 并填写你的配置
# cp .env.example .env
# ============================================================

# SiliconFlow API Key（必须配置）
# 获取地址: https://cloud.siliconflow.cn/i/OVI2n57p （分享链接，双方可获得 16 元代金券）
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容 API 地址（SiliconFlow）
API_BASE_URL=https://api.siliconflow.cn/v1

# SiliconFlow 实测默认模型
PRIMARY_MODEL=deepseek-ai/DeepSeek-V4-Flash
PRIMARY_MODEL_FALLBACK=deepseek-ai/DeepSeek-V4-Pro
CAPTCHA_MODEL=Qwen/Qwen3-VL-32B-Instruct
CAPTCHA_MODEL_FALLBACK=Qwen/Qwen3-VL-30B-A3B-Instruct

# 验证码失败恢复策略
CAPTCHA_FAILURE_MAX_RETRIES=2
CAPTCHA_FAILURE_RETRY_DELAY_SECONDS=900
WARP_RESTART_COOLDOWN_SECONDS=300
TASK_SPACING_SECONDS=5
