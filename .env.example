# ============================================================
# Epic Kiosk 环境变量配置文件
# ============================================================
# 复制此文件为 .env 并填写你的配置
# cp .env.example .env
# ============================================================

# SiliconFlow API Key（必须配置）
# 获取地址: https://cloud.siliconflow.cn/i/OVI2n57p （分享链接，双方可获得 16 元代金券）
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容 API 地址（SiliconFlow）
API_BASE_URL=https://api.siliconflow.cn/v1
